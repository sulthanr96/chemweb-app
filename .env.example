# Salin file ini jadi .env lalu isi nilainya (JANGAN commit/kirim .env yang sudah berisi kredensial asli).

# Connection string MongoDB Atlas — Database > Connect > Drivers.
# Contoh: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/chemwebapp
MONGODB_URI=

# Port lokal untuk server Express (opsional, default 3000)
PORT=3000

# Opsional: batasi origin yang boleh akses API, pisah pakai koma.
# Kosongkan kalau masih dev lokal (semua origin diizinkan).
# Contoh: ALLOWED_ORIGIN=https://chemweb-app.onrender.com
ALLOWED_ORIGIN=
